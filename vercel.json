{
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "post.html,data/**"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/post/:slug", "destination": "/api/index.js" },
    { "source": "/sitemap.xml", "destination": "/api/index.js" }
  ]
}
